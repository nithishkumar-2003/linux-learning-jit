DESCRIPTION = "ADI Linux kernel with GMSL support for Raspberry Pi 4"
LICENSE = "CLOSED"

inherit kernel

DEPENDS += "linux-firmware"
RDEPENDS:${PN} += "linux-firmware"

# Make this kernel available as virtual/kernel
PROVIDES = "linux-adi-gmsl virtual/kernel"

SRC_URI = "git://github.com/analogdevicesinc/linux.git;branch=gmsl/rpi-6.1.y;protocol=https"
SRCREV = "${AUTOREV}"

PV = "6.1+adi-gmsl"
S = "${WORKDIR}/git"

KCONFIG_MODE = "alldefconfig"
KBUILD_DEFCONFIG = "adi_gmsl_defconfig"


do_install:append() {
    # Create boot directories
    install -d ${D}/boot
    install -d ${D}/boot/overlays

    # Install kernel Image
    install -m 0644 ${B}/arch/arm64/boot/Image ${D}/boot/

    # Install DTBs
    for dtb in ${KERNEL_DEVICETREE}; do
        install -m 0644 "${B}/arch/arm64/boot/dts/${dtb}" "${D}/boot/"
    done

    # Install DTBOs if they exist
    dtbo_dir="${B}/arch/arm64/boot/dts/overlays"
    if [ -d "$dtbo_dir" ] && compgen -G "$dtbo_dir/*.dtbo" > /dev/null; then
        for dtbo in "$dtbo_dir"/*.dtbo; do
            install -m 0644 "${dtbo}" "${D}/boot/overlays/"
        done
    fi

    # Optional: generate config.txt with all overlays
    CONFIG_FILE=${D}/boot/config.txt.gpiooverlays
    touch $CONFIG_FILE
    if [ -d "$dtbo_dir" ]; then
        for dtbo in "$dtbo_dir"/*.dtbo; do
            overlay=$(basename "$dtbo" .dtbo)
            echo "dtoverlay=${overlay}" >> $CONFIG_FILE
        done
    fi
}


#FILES:${PN} += "/boot/overlays/ /boot/overlays/*.dtbo /boot/Image /boot/*.dtb /boot/config.txt"


# Files to package in kernel package
FILES:${PN} += " \
    /boot/Image \
    /boot/*.dtb \
    /boot/overlays \
    /boot/overlays/*.dtbo \
    /boot/config.txt \
    /boot/config.txt.gpiooverlays \
